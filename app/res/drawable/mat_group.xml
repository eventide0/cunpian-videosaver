<?xml version="1.0" encoding="utf-8"?>
<!-- iOS 面板：深 20% 玻璃底 + 高光描边（白字要能读，底必须暗一点） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#33000000"/>
            <stroke android:width="1px" android:color="#26FFFFFF"/>
            <corners android:radius="16dp"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="1px" android:top="1px" android:left="12dp" android:right="12dp">
        <shape android:shape="rectangle"><solid android:color="#33FFFFFF"/></shape>
    </item>
</layer-list>
