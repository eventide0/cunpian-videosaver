<?xml version="1.0" encoding="utf-8"?>
<!-- 无钮滑杆：玻璃轨道 + 蓝色填充（iOS 18 风格） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background" android:gravity="center_vertical">
        <shape android:shape="rectangle">
            <corners android:radius="999dp"/>
            <solid android:color="#1AFFFFFF"/>
            <stroke android:width="1px" android:color="#1FFFFFFF"/>
            <size android:height="12dp"/>
        </shape>
    </item>
    <item android:id="@android:id/progress" android:gravity="center_vertical">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp"/>
                <solid android:color="#E60A84FF"/>
            </shape>
        </clip>
    </item>
</layer-list>
