<?xml version="1.0" encoding="utf-8"?>
<!-- 玻璃滑钮：玻璃珠（径向高光），按压态放大加深 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <layer-list>
            <item android:width="32dp" android:height="32dp">
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="18dp"
                        android:centerX="0.35" android:centerY="0.28"
                        android:startColor="#CCFFFFFF" android:endColor="#33FFFFFF"/>
                    <stroke android:width="1dp" android:color="#A6FFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:width="26dp" android:height="26dp">
                <shape android:shape="oval">
                    <gradient android:type="radial" android:gradientRadius="15dp"
                        android:centerX="0.35" android:centerY="0.28"
                        android:startColor="#B3FFFFFF" android:endColor="#2EFFFFFF"/>
                    <stroke android:width="1dp" android:color="#8CFFFFFF"/>
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
