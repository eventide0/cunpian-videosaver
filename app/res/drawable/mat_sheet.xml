<?xml version="1.0" encoding="utf-8"?>
<!-- 底部设置面板容器：深色玻璃（模态需要更实一些） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C2131723"/>
            <stroke android:width="1px" android:color="#2EFFFFFF"/>
            <corners android:radius="22dp"/>
        </shape>
    </item>
    <item android:gravity="top" android:height="1px" android:top="1px" android:left="16dp" android:right="16dp">
        <shape android:shape="rectangle"><solid android:color="#40FFFFFF"/></shape>
    </item>
</layer-list>
