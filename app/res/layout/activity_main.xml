<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/wall"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/wall_default"/>

    <!-- 全局 scrim：壁纸统一压暗（竖渐变），浅玻璃面板靠明度差分层 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/scrim_v"/>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0.4"
        android:background="@drawable/noise_tile"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="14dp"
        android:paddingRight="14dp"
        android:paddingTop="18dp"
        android:paddingBottom="14dp">

        <!-- 大标题行 + 壁纸小按钮 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="存片"
                    android:textSize="30sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingLeft="2dp"
                    android:text="粘贴或分享链接 · 无水印保存"
                    android:textSize="12sp"
                    android:textColor="#8CFFFFFF"/>
            </LinearLayout>

            <TextView
                android:id="@+id/btn_settings"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:gravity="center"
                android:text="🖼"
                android:textSize="14sp"
                android:background="@drawable/ic_tile"/>
        </LinearLayout>

        <!-- iOS 搜索框式输入 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/mat_search"
            android:paddingLeft="14dp"
            android:paddingRight="8dp"
            android:paddingTop="5dp"
            android:paddingBottom="5dp"
            android:layout_marginTop="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🔍"
                android:textSize="13sp"/>

            <EditText
                android:id="@+id/input"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="粘贴视频分享链接"
                android:textColorHint="#73FFFFFF"
                android:textColor="#FFFFFF"
                android:textSize="13.5sp"
                android:maxLines="3"
                android:padding="7dp"/>

            <TextView
                android:id="@+id/btn_paste"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="粘贴"
                android:textSize="11sp"
                android:textColor="#D9FFFFFF"
                android:background="@drawable/btn_ghost"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"/>

            <TextView
                android:id="@+id/btn_clear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="6dp"
                android:text="清空"
                android:textSize="11sp"
                android:textColor="#D9FFFFFF"
                android:background="@drawable/btn_ghost"
                android:paddingLeft="11dp"
                android:paddingRight="11dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"/>
        </LinearLayout>

        <!-- 主 CTA -->
        <TextView
            android:id="@+id/cta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center"
            android:paddingTop="13dp"
            android:paddingBottom="13dp"
            android:text="解 析"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:background="@drawable/btn_cta"/>

        <!-- 下载进度汇总：有下载任务时显示，滚动结果区时仍固定可见 -->
        <TextView
            android:id="@+id/dl_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:background="@drawable/mat_group"
            android:paddingLeft="12dp"
            android:paddingRight="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="#D9FFFFFF"
            android:textSize="10.5sp"
            android:visibility="gone"/>

        <!-- 结果分组（占中段） -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:scrollbars="none"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:layout_marginBottom="6dp"
                    android:text="结 果"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="#73FFFFFF"/>

                <LinearLayout
                    android:id="@+id/results"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>
        </ScrollView>

        <!-- 历史分组（停靠底部） -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="12dp"
            android:layout_marginBottom="6dp"
            android:text="历 史"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#73FFFFFF"/>

        <!-- 历史区封顶并内部滚动，保证结果区始终有显示空间。 -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.8"
            android:layout_marginTop="2dp"
            android:scrollbars="none"
            android:fillViewport="false">

            <LinearLayout
                android:id="@+id/history"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/mat_group"/>
        </ScrollView>
    </LinearLayout>
</FrameLayout>
